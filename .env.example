# Claude API key. Without it the app runs in "demo mode" with canned AI output.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
DP_MODEL=
# Optional: set to "off" to skip live web research in Demand Lab and Audience Finder
DP_WEB_RESEARCH=

# Postgres connection string (Neon, Supabase, etc.). Required on Vercel.
# Leave empty locally to use the embedded Postgres (PGlite) in ./data/pglite.
DATABASE_URL=
# Optional: max connections per server instance (default 5)
DATABASE_POOL_MAX=
# Optional: where the embedded local database lives (default ./data/pglite)
PGLITE_PATH=

# Optional: Stripe secret key. Without it checkout runs in test mode (orders are simulated).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public base URL used for Stripe redirects
APP_URL=http://localhost:3000
